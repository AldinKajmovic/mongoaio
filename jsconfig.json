{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "*.js",
    "src/**/*.js",
    "eslint-rules/**/*.js",
    "src/**/*.d.ts"
  ]
}
