{
  "name": "mongoaio",
  "version": "1.8.0",
  "description": "MongoDB editor with compare & sync feature",
  "author": {
    "name": "Aldin K",
    "email": "kajmovicaldin@outlook.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "test": "node --test \"tests/unit/*.test.{js,mjs}\" \"tests/integration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.{js,mjs}\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\"",
    "test:all": "npm test && npm run test:e2e",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux deb AppImage",
    "build:mac": "electron-builder --mac --x64 --arm64"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "mongodb": "^6.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.mongoAIO.app",
    "productName": "MongoAIO",
    "publish": {
      "provider": "github",
      "owner": "AldinKajmovic",
      "repo": "mongoaio"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!tests/**",
      "!.codegraph/**",
      "!.github/**",
      "!dist/**",
      "!eslint-rules/**",
      "!eslint.config.js",
      "!jsconfig.json",
      "!README.md",
      "!build/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icons"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.png",
      "category": "public.app-category.developer-tools"
    }
  }
}